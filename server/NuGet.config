<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Repo-scoped feeds. <clear /> drops any inherited machine/user sources so restore is
       deterministic under central package management (Directory.Packages.props) — otherwise an
       inherited extra feed trips NU1507 (2 unmapped sources) and makes restore query the slow
       private feed for every public package. No credentials live here: the github feed is only
       hit for Schulz.* packages, and its token is supplied per-developer via a user-level
       NuGet.config or the standard NuGet env vars, never committed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/schulzsystemtechnik/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Everything public resolves from nuget.org only. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- Schulz-internal packages resolve from the private org feed. -->
    <packageSource key="github">
      <package pattern="Schulz.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
